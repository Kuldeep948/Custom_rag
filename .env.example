# ============================================================
# RAG Knowledge Base API — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains real secrets.
# ============================================================

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME="RAG Knowledge Base API"
APP_VERSION="1.0.0"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── API Authentication ────────────────────────────────────────
API_KEY=dev-api-key-change-in-production
# Generate a strong key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@postgres:5432/ragdb
DATABASE_URL_SYNC=postgresql://raguser:ragpassword@postgres:5432/ragdb

# ── Google Gemini ─────────────────────────────────────────────
# Used for: LLM answer synthesis + Vision OCR for scanned PDFs
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Embedding ─────────────────────────────────────────────────
# sentence_transformer — free, local, no API key needed (default ✓)
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ── Qdrant Vector Database ────────────────────────────────────
# Local Docker:  QDRANT_URL=http://localhost:6333  (leave QDRANT_API_KEY empty)
# Qdrant Cloud:  fill both values below
# Get your cluster at: https://cloud.qdrant.io
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here

# ── File Processing ───────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,py,txt,md,js,ts,java,cpp,c,go,rs
UPLOAD_DIR=./uploads

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# ── Query ─────────────────────────────────────────────────────
DEFAULT_TOP_K=5
MAX_TOP_K=20

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
